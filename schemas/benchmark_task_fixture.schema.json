{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iris-qec:schema:benchmark_task_fixture:0.1.0-draft",
  "title": "Benchmark task fixture",
  "description": "One StabilizerBench task instance plus the documented baseline evidence that a later reproduction run is compared against. DRAFT (Week 1): not yet exercised against real runs.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRef": {
      "description": "Pointer to the evidence for a recorded fact. Every recorded fact must carry one.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "File path relative to the repository root."
        },
        "url": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "locator": {
          "type": "string",
          "description": "Line range, JSON pointer, table/figure id, or record key within the source."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "additionalProperties": false
    },
    "knowable": {
      "description": "A value that may be unknown. Unknown/unavailable values are never silently omitted or guessed.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {},
            "source": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sourceRef"
              },
              "minItems": 1
            },
            "derived": {
              "type": "boolean",
              "description": "True if computed from recorded values rather than read directly."
            }
          },
          "required": [
            "status",
            "value",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "unavailable",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string"
            },
            "evidence_needed": {
              "type": "string",
              "description": "What artifact/measurement would resolve this field."
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "circuitRef": {
      "type": "object",
      "properties": {
        "format": {
          "const": "stim"
        },
        "path": {
          "type": "string"
        },
        "inline_text": {
          "type": "string"
        },
        "normalized_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of UTF-8 text after the normalization in metric_dictionary (newlines unescaped, whitespace collapsed, comments dropped, trailing newline)."
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        }
      },
      "required": [
        "format",
        "normalized_sha256",
        "source"
      ],
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "inline_text"
          ]
        }
      ],
      "additionalProperties": false
    },
    "circuitMetrics": {
      "type": "object",
      "properties": {
        "cx_count": {
          "type": "integer",
          "minimum": 0
        },
        "volume": {
          "type": "integer",
          "minimum": 0
        },
        "one_qubit_gates": {
          "type": "integer",
          "minimum": 0
        },
        "two_qubit_gates": {
          "type": "integer",
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "seedRef": {
      "type": "string"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "status",
    "benchmark",
    "task",
    "baseline_records",
    "unknown_fields"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "fixture_id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "candidate",
        "selected",
        "rejected"
      ]
    },
    "selection_rationale": {
      "type": "string"
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_url",
        "commit",
        "dataset_manifest",
        "verifier_impl"
      ],
      "properties": {
        "repo_url": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_date": {
          "$ref": "#/$defs/timestamp"
        },
        "paper": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "pdf_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "source": {
              "$ref": "#/$defs/sourceRef"
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "dataset_manifest": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "version",
            "n_instances"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "version": {
              "$ref": "#/$defs/knowable"
            },
            "n_instances": {
              "type": "integer"
            },
            "last_changed_commit": {
              "type": "string"
            }
          }
        },
        "verifier_impl": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "path",
              "sha256"
            ],
            "properties": {
              "role": {
                "enum": [
                  "stabilizer_oracle",
                  "fault_oracle",
                  "circuit_metrics",
                  "scoring_aggregation",
                  "harness"
                ]
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "version": {
                "$ref": "#/$defs/knowable"
              }
            }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "benchmark_category",
        "code_name",
        "code_family",
        "n_physical",
        "k_logical",
        "distance",
        "stabilizer_generators",
        "generator_count",
        "original_input",
        "required_output",
        "success_criterion"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "benchmark_category": {
          "enum": [
            "B1_state_preparation",
            "B2_circuit_optimization",
            "B3_fault_tolerant_generation"
          ]
        },
        "code_name": {
          "type": "string"
        },
        "code_family": {
          "$ref": "#/$defs/knowable"
        },
        "n_physical": {
          "type": "integer"
        },
        "k_logical": {
          "type": "integer"
        },
        "distance": {
          "type": "integer"
        },
        "stabilizer_generators": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[IXYZ]+$"
          }
        },
        "generator_count": {
          "type": "integer"
        },
        "original_input": {
          "type": "object",
          "description": "Exactly what the benchmark gives the agent (excluding prompt text).",
          "properties": {
            "baseline_circuit": {
              "$ref": "#/$defs/circuitRef"
            },
            "dataset_record": {
              "$ref": "#/$defs/sourceRef"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "dataset_record"
          ]
        },
        "required_output": {
          "type": "string"
        },
        "success_criterion": {
          "type": "string"
        }
      }
    },
    "baseline_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "agent_label",
          "run_file",
          "output_circuit",
          "verifier_result",
          "model",
          "inference_settings",
          "attempt_budget",
          "timeout_policy",
          "stopping_rule",
          "prompt",
          "evidence"
        ],
        "properties": {
          "record_id": {
            "$ref": "#/$defs/id"
          },
          "agent_label": {
            "type": "string",
            "description": "Label as it appears in the source (e.g. 'claude-opus-4.6')."
          },
          "run_file": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "run_started_at": {
                "$ref": "#/$defs/timestamp"
              },
              "run_finished_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          },
          "published_config_label": {
            "type": "string",
            "description": "Paper configuration label, e.g. '1 att / 900s'."
          },
          "output_circuit": {
            "oneOf": [
              {
                "$ref": "#/$defs/circuitRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "verifier_result": {
            "type": "object",
            "properties": {
              "valid": {
                "type": "boolean"
              },
              "preserved": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "per_generator": {
                "type": "object",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "metrics_baseline": {
                "$ref": "#/$defs/circuitMetrics"
              },
              "metrics_output": {
                "$ref": "#/$defs/circuitMetrics"
              },
              "improved": {
                "type": "boolean"
              },
              "quality_factor": {
                "$ref": "#/$defs/knowable"
              },
              "elapsed_seconds": {
                "$ref": "#/$defs/knowable"
              },
              "verifier_calls_logged": {
                "$ref": "#/$defs/knowable"
              },
              "source": {
                "$ref": "#/$defs/sourceRef"
              }
            },
            "required": [
              "valid",
              "source"
            ]
          },
          "published_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string"
                },
                "source": {
                  "$ref": "#/$defs/sourceRef"
                },
                "rederived_from_stored_data": {
                  "type": "boolean"
                }
              },
              "required": [
                "claim",
                "source"
              ]
            }
          },
          "model": {
            "$ref": "#/$defs/knowable"
          },
          "harness": {
            "$ref": "#/$defs/knowable"
          },
          "inference_settings": {
            "$ref": "#/$defs/knowable"
          },
          "attempt_budget": {
            "$ref": "#/$defs/knowable"
          },
          "timeout_policy": {
            "$ref": "#/$defs/knowable"
          },
          "stopping_rule": {
            "$ref": "#/$defs/knowable"
          },
          "prompt": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "recovered_from_commit": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "present",
                  "recovered_from_history",
                  "unavailable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "token_usage": {
            "$ref": "#/$defs/knowable"
          },
          "monetary_cost_usd": {
            "$ref": "#/$defs/knowable"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceRef"
            },
            "minItems": 1
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "description": "How task-level scores are derived.",
      "properties": {
        "formula_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "minItems": 1
        },
        "task_quality_factor": {
          "$ref": "#/$defs/knowable"
        }
      }
    },
    "provenance_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "unknown_fields": {
      "type": "array",
      "description": "Explicit enumeration of every field whose value is unknown/unavailable, with the evidence needed.",
      "items": {
        "type": "object",
        "required": [
          "field",
          "status",
          "evidence_needed"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "status": {
            "enum": [
              "unknown",
              "unavailable"
            ]
          },
          "evidence_needed": {
            "type": "string"
          }
        }
      }
    }
  }
}
