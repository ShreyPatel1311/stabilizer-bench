{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iris-qec:schema:pipeline_artifact:0.1.0-draft",
  "title": "Pipeline artifact",
  "description": "Any artifact produced or consumed by the pipeline (circuit, plan, diagnostic, claim record, ensemble). Carries lineage so a final circuit can be traced to its inputs. DRAFT (Week 1): not yet exercised against real runs.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRef": {
      "description": "Pointer to the evidence for a recorded fact. Every recorded fact must carry one.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "File path relative to the repository root."
        },
        "url": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "locator": {
          "type": "string",
          "description": "Line range, JSON pointer, table/figure id, or record key within the source."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "additionalProperties": false
    },
    "knowable": {
      "description": "A value that may be unknown. Unknown/unavailable values are never silently omitted or guessed.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {},
            "source": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sourceRef"
              },
              "minItems": 1
            },
            "derived": {
              "type": "boolean",
              "description": "True if computed from recorded values rather than read directly."
            }
          },
          "required": [
            "status",
            "value",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "unavailable",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string"
            },
            "evidence_needed": {
              "type": "string",
              "description": "What artifact/measurement would resolve this field."
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "circuitRef": {
      "type": "object",
      "properties": {
        "format": {
          "const": "stim"
        },
        "path": {
          "type": "string"
        },
        "inline_text": {
          "type": "string"
        },
        "normalized_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of UTF-8 text after the normalization in metric_dictionary (newlines unescaped, whitespace collapsed, comments dropped, trailing newline)."
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        }
      },
      "required": [
        "format",
        "normalized_sha256",
        "source"
      ],
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "inline_text"
          ]
        }
      ],
      "additionalProperties": false
    },
    "circuitMetrics": {
      "type": "object",
      "properties": {
        "cx_count": {
          "type": "integer",
          "minimum": 0
        },
        "volume": {
          "type": "integer",
          "minimum": 0
        },
        "one_qubit_gates": {
          "type": "integer",
          "minimum": 0
        },
        "two_qubit_gates": {
          "type": "integer",
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "seedRef": {
      "type": "string"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "created_at",
    "content",
    "lineage",
    "produced_by"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "artifact_id": {
      "$ref": "#/$defs/id"
    },
    "artifact_type": {
      "enum": [
        "stim_circuit",
        "plan",
        "diagnostic_report",
        "claim_record",
        "candidate_set",
        "final_submission",
        "prompt",
        "raw_model_output",
        "other"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "content": {
      "type": "object",
      "properties": {
        "media_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "inline_text": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "media_type",
        "sha256"
      ],
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "inline_text"
          ]
        }
      ]
    },
    "task_ref": {
      "type": "object",
      "properties": {
        "fixture_id": {
          "$ref": "#/$defs/id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "lineage": {
      "type": "object",
      "required": [
        "parents",
        "derivation"
      ],
      "properties": {
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "artifact_ids this artifact was derived from; empty only for roots."
        },
        "derivation": {
          "enum": [
            "root_input",
            "classical_synthesis",
            "peephole_pass",
            "llm_generation",
            "llm_repair",
            "ensemble_selection",
            "flag_insertion",
            "diagnostic",
            "summary",
            "manual",
            "copy"
          ]
        },
        "action_class": {
          "enum": [
            "interventional",
            "epistemic",
            "none"
          ],
          "description": "IRIS-QEC distinction: interventional modifies the retained solution; epistemic only gathers evidence."
        },
        "attempt_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "produced_by": {
      "type": "object",
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "component_version": {
          "$ref": "#/$defs/knowable"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "trace_event_id": {
          "$ref": "#/$defs/id"
        },
        "model_call_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "verifier_response_id": {
            "$ref": "#/$defs/id"
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": [
          "verifier_response_id"
        ]
      }
    },
    "provenance_id": {
      "$ref": "#/$defs/id"
    }
  }
}
